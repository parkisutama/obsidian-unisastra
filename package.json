{
	"name": "unisastra",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"obsidianMinAppVersion": "1.14.4",
	"author": "Parkis Utama",
	"repository": {
		"type": "git",
		"url": "https://github.com/parkisutama/obsidian-unisastra"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@codemirror/commands": "^6.8.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/json": "0.14.0",
		"@types/node": "^24.19.0",
		"@typescript-eslint/parser": "^8.71.1",
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"husky": "^9.1.7",
		"obsidian": "1.14.4",
		"rumdl": "^0.2.78",
		"sass": "^1.105.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vitepress": "^1.6.4",
		"vitest": "^5.0.3"
	},
	"description": "High-precision drafting for Obsidian with typewriter scrolling, whitespace visualization, and outliner focus",
	"keywords": [
		"obsidian",
		"writing",
		"outliner",
		"markdown"
	],
	"license": "GPL-3.0-only",
	"scripts": {
		"prepare": "husky",
		"dev": "node scripts/dev.ts",
		"debug": "node scripts/dev.ts --debug",
		"build": "node scripts/build.ts",
		"deploy": "pnpm run build && node scripts/deploy.ts",
		"typecheck": "tsc --noEmit --incremental false",
		"lint": "biome check",
		"lint:obsidian": "eslint src manifest.json LICENSE",
		"lint:styles": "stylelint \"src/**/*.scss\"",
		"lint:md": "node ./scripts/lint-md.mjs check .",
		"fix": "pnpm run fix:biome && pnpm run fix:styles && pnpm run fix:md",
		"fix:biome": "biome check --write",
		"fix:styles": "stylelint --fix \"src/**/*.scss\"",
		"fix:md": "node ./scripts/lint-md.mjs check --fix .",
		"test": "node ./scripts/test.mjs",
		"test:coverage": "node ./scripts/test.mjs --coverage",
		"verify:artifacts": "node scripts/verify-artifacts.ts",
		"conformance": "node --test conformance/standard.test.mjs",
		"version:sync": "node scripts/sync-version.mjs",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run lint:obsidian && pnpm run lint:styles && pnpm run lint:md && pnpm run test",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run lint:obsidian && pnpm run lint:styles && pnpm run lint:md && pnpm run test:coverage && pnpm run build && pnpm run verify:artifacts && pnpm run docs:build",
		"validate:release-tag": "node ./scripts/validate-release-tag.mjs",
		"release": "node scripts/release.ts",
		"ci": "pnpm run build && pnpm run verify:artifacts && node scripts/generate-ci-artefacts.ts"
	},
	"private": true
}
