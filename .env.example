# Optional. When set, `pnpm run dev` and `pnpm run deploy` copy dist/ into this folder.
# Target must be <vault>/<active-config>/plugins/unisastra; plugins must already exist.
# Runtime verification (default) requires running Obsidian with its CLI enabled/on PATH.
# Root/config aliases are supported; redirected plugins/plugin folders and linked files are rejected.
# Point it at a test vault, not a working vault.
#
# Example:
# OBSIDIAN_VAULT_PLUGIN_PATH=/absolute/path/to/TestVault/.obsidian/plugins/unisastra
OBSIDIAN_VAULT_PLUGIN_PATH=

# Set structural explicitly for offline, structural-only checks. It cannot verify the active config.
# Failed runtime checks never fall back automatically. No JSON filename proves vault identity.
OBSIDIAN_DEPLOY_VERIFICATION=runtime
